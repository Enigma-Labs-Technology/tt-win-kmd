# Normalise line endings: LF in the repository, native on checkout, except for
# formats where a specific ending matters on the Windows side.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.c    text
*.h    text
*.md   text
*.txt  text
*.json text
*.xml  text

*.ps1     text eol=crlf
*.inf     text eol=crlf
*.rc      text eol=crlf
*.vcxproj text eol=crlf
*.props   text eol=crlf

*.png binary
*.bmp binary
*.ppm binary
*.fd  binary
*.iso binary
*.qcow2 binary
*.tar.xz binary
