;
; ttkmd.inf - Tenstorrent Blackhole KMDF driver (Windows port of tt-kmd)
; Maps to: tt-kmd/module.c pci_device_id table (module.c:64-71, enumerate.h:15-18)
;          + udev-50-tenstorrent.rules (device node access policy; see OQ-2)
;
; Release package. Binds only the Blackhole p150a (PCI\VEN_1E52&DEV_B140,
; subsystem 1E52:0040), the one board this port has been validated on
; (DD-18). Other Blackhole boards (p100, p150b/c, p300, Galaxy) share
; DEV_B140 but are unvalidated and deliberately not matched; Wormhole
; (DEV_401E) and Grayskull (DEV_FACA) have no support in this driver.
; The hardware-free ROOT\TTKMD_SOFT node and the ttsim/QEMU model live in
; ttkmd-test.inf (Debug configuration) and never ship in a signed package.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = TenstorrentAccelerator
ClassGuid   = {17db3097-300a-4168-8a1d-6c26bba9263f}
Provider    = %ManufacturerName%
CatalogFile = ttkmd.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
ttkmd.sys = 1,,

; ---------------- Custom device setup class (DD-2) ----------------
[ClassInstall32]
AddReg = TtClassReg

[TtClassReg]
HKR,,,0,%ClassName%
HKR,,Icon,,-10
; OQ-2: SYSTEM/Admins full control, interactive users read/write.
; Linux ships MODE 0666 via udev; deliberately tightened here.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[Manufacturer]
%ManufacturerName% = Tenstorrent,NT$ARCH$.10.0...22000

[Tenstorrent.NT$ARCH$.10.0...22000]
%TtP150a.DeviceDesc% = TtDevice_Install, PCI\VEN_1E52&DEV_B140&SUBSYS_00401E52

[TtDevice_Install.NT]
CopyFiles = TtDriverCopy

[TtDriverCopy]
ttkmd.sys

[TtDevice_Install.NT.HW]
AddReg = TtDeviceHwReg, TtDmaRemappingPolicy

[TtDeviceHwReg]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[TtDmaRemappingPolicy]
; Opt into DMA remapping (Kernel DMA Protection). Driver-allocated buffers use
; bus-logical addresses, and PIN_PAGES backs sysmem pins with those buffers
; (DD-16), so the driver is correct with remapping on or off.
HKR,"DMA Management","RemappingSupported",0x00010001,1

[TtDevice_Install.NT.Services]
AddService = ttkmd, %SPSVCINST_ASSOCSERVICE%, TtService_Install

[TtService_Install]
DisplayName   = %ServiceDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\ttkmd.sys
AddReg        = TtServiceParameters

[TtServiceParameters]
HKR,Parameters,DmaRemappingCompatible,0x00010001,1
; DD-17: per-device ceiling on outstanding DMA-buffer memory, in MiB (0 = unlimited).
HKR,Parameters,DmaBufferLimitMiB,0x00010001,4096

[TtDevice_Install.NT.Wdf]
KmdfService = ttkmd, TtWdfSect

[TtWdfSect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "Tenstorrent (community Windows port)"
ClassName              = "Tenstorrent accelerators"
DiskName               = "Tenstorrent ttkmd Installation Disk"
TtP150a.DeviceDesc     = "Tenstorrent Blackhole p150a AI Accelerator"
ServiceDesc            = "Tenstorrent kernel-mode driver (ttkmd)"
