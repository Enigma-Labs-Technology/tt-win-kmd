<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{f3e15b78-2f2e-42eb-b88d-dd4c82d2d852}</ProjectGuid>
    <TemplateGuid>{497e31cb-056b-4f31-abb8-447fd55ee5a5}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>ttkmd</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <!-- One source for the driver version: TT_VERSION_*, VERSIONINFO, INF DriverVer. -->
  <Import Project="ttkmd-version.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!-- KMDF 1.33 is in-box on every Windows 11 build (22000 and later), which
         matches the INF's OS floor. 1.35 would need 24H2 (DD-18). -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <DebuggerFlavor>DbgengKernelDebugger</DebuggerFlavor>
    <CodeAnalysisRuleSet>$(WDKContentRoot)CodeAnalysis\DriverRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalIncludeDirectories>$(ProjectDir)..\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Version numbers from ttkmd-version.props (GET_DRIVER_INFO). -->
      <PreprocessorDefinitions>TT_VERSION_MAJOR=$(TtDriverVersionMajor);TT_VERSION_MINOR=$(TtDriverVersionMinor);TT_VERSION_PATCH=$(TtDriverVersionPatch);TT_VERSION_REVISION=$(TtDriverVersionRevision);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Debug ioctl surface (ttkmd_debug.h): Debug configuration only, so a
           Release/attestation build never carries it (docs/signing-and-deployment.md). -->
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">TT_DEBUG_INTERFACES=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>TT_VERSION_MAJOR=$(TtDriverVersionMajor);TT_VERSION_MINOR=$(TtDriverVersionMinor);TT_VERSION_PATCH=$(TtDriverVersionPatch);TT_VERSION_REVISION=$(TtDriverVersionRevision);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>
      <!-- Kernel-mode Hardware-enforced Stack Protection (kernel CET shadow
           stacks) blocks drivers without CETCOMPAT metadata from loading
           (observed live: StartService error 1450 on a host with
           DeviceGuard\Scenarios\KernelShadowStacks Enabled=1). Plain C KMDF
           code with no stack switching is shadow-stack safe. -->
      <!-- /INTEGRITYCHECK: required for PsSetCreateProcessNotifyRoutineEx
           (DD-15); the loader then verifies the image signature at load. -->
      <AdditionalOptions>/CETCOMPAT /INTEGRITYCHECK %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <Inf>
      <TimeStamp>*</TimeStamp>
      <!-- DriverVer version part from ttkmd-version.props; without it stampinf
           writes 1.0 and the package version disagrees with the driver. -->
      <SpecifyDriverVerDirectiveVersion>true</SpecifyDriverVerDirectiveVersion>
      <DriverVersionNumber>$(TtDriverVersionNumber)</DriverVersionNumber>
    </Inf>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="device.c" />
    <ClCompile Include="ioctl.c" />
    <ClCompile Include="blackhole.c" />
    <ClCompile Include="memory.c" />
    <ClCompile Include="reset.c" />
    <ClCompile Include="locks.c" />
    <ClCompile Include="power.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="ttkmd.h" />
    <ClInclude Include="trace.h" />
    <ClInclude Include="blackhole.h" />
    <ClInclude Include="..\include\ttkmd_ioctl.h" />
    <ClInclude Include="..\include\ttkmd_abi_check.h" />
    <ClInclude Include="..\include\ttkmd_debug.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="ttkmd.rc" />
  </ItemGroup>
  <ItemGroup>
    <!-- Release: the p150a package that gets signed. Debug: the test package
         that additionally binds the ttsim/QEMU model and the ROOT\TTKMD_SOFT
         load-test node (DD-18); it is never submitted for signing. -->
    <Inf Include="ttkmd.inf" Condition="'$(Configuration)'=='Release'" />
    <Inf Include="ttkmd-test.inf" Condition="'$(Configuration)'=='Debug'" />
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
